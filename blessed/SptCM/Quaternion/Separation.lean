module

public import blessed.SptCM.CM.ClassPolynomials
public import blessed.SptCM.Lemmas.VolumeArithmetic
public import Mathlib.FieldTheory.SplittingField.Construction

public section

-- Use the standard additive structure already supplied by the ring instance.
attribute [-instance] instAddCommGroupOfIsSimpleAddGroupOfIsNilpotent


/-!
# Quaternionic volume and separation

The supersingular specialization and the cited local description of the
level-six Eichler order are exposed as hypotheses.  This file proves the
finite arithmetic deductions: opposite orientation scalars force
noncommutation, covolume plus Hadamard gives the volume inequality, and that
inequality contradicts the collision bound.
-/

namespace SptCM

universe u

open Polynomial

/-- A generic level-preserving endomorphism order, represented as the subtype
of endomorphisms preserving the chosen level structure. -/
@[expose]
def levelEndomorphismOrder {E : Type*} (PreservesLevel : E → Prop) :=
  {α : E // PreservesLevel α}

/-- Reduced norm in an algebra with quaternionic conjugation. -/
@[expose]
def reducedNorm {R : Type*} [Mul R] [Star R] (α : R) : R :=
  α * star α

/-- Reduced trace in an algebra with quaternionic conjugation. -/
@[expose]
def reducedTrace {R : Type*} [Add R] [Star R] (α : R) : R :=
  α + star α

/-- The local index computations at `2` and `3`, together with
multiplicativity of covolume, give covolume `6ℓ`. -/
theorem levelOrder_covolume
    {ℓ fullCovolume levelIndex levelCovolume : ℕ}
    (hfull : fullCovolume = ℓ) (hindex : levelIndex = 2 * 3)
    (hscale : levelCovolume = levelIndex * fullCovolume) :
    levelCovolume = 6 * ℓ := by
  calc
    levelCovolume = levelIndex * fullCovolume := hscale
    _ = (2 * 3) * ℓ := by rw [hindex, hfull]
    _ = 6 * ℓ := by norm_num

/-- The purely ordered part of the volume lemma.  The first hypothesis is the
covolume lower bound for the lattice generated by `1, α, β, αβ`; the second
is the cited Hadamard upper bound after norm multiplicativity. -/
theorem levelSix_volume_inequality
    {ℓ latticeCovolume normAlpha normBeta : ℕ}
    (hlattice : 6 * ℓ ≤ latticeCovolume)
    (hHadamard : latticeCovolume ≤ 4 * normAlpha * normBeta) :
    6 * ℓ ≤ 4 * normAlpha * normBeta := by
  omega

/-- The scalar actions `0,1` from the first pair of orientations cannot agree
with the scalar actions `3,4` from the second pair.  A centralizer/characteristic
polynomial argument supplies `hcommuting_action` in the geometric setting. -/
theorem orientation_actions_noncommute
    {End : Type*} (Commutes : End → End → Prop) (α β : End)
    (actionBeta : ℕ)
    (hbeta : actionBeta = 3 ∨ actionBeta = 4)
    (hcommuting_action : Commutes α β → actionBeta = 0 ∨ actionBeta = 1) :
    ¬ Commutes α β := by
  intro hcomm
  rcases hbeta with h | h <;>
    rcases hcommuting_action hcomm with h' | h' <;> omega

/-- A concrete centralizer-to-orientation argument.  The genuinely
quaternionic input is only `hcentralizer`: commuting elements with the common
quadratic characteristic polynomial satisfy `β = α` or `β = 1 - α`.
The four scalar actions on the level-six subgroup then rule this out. -/
theorem orientation_actions_noncommute_of_centralizer
    {R : Type*} [Ring R] (α β : R) (action : R →+* ZMod 6)
    (hactionAlpha : action α = 0 ∨ action α = 1)
    (hactionBeta : action β = 3 ∨ action β = 4)
    (hcentralizer : Commute α β → β = α ∨ β = 1 - α) :
    ¬ Commute α β := by
  intro hcomm
  have h03 : (0 : ZMod 6) ≠ 3 := by decide
  have h04 : (0 : ZMod 6) ≠ 4 := by decide
  have h13 : (1 : ZMod 6) ≠ 3 := by decide
  have h14 : (1 : ZMod 6) ≠ 4 := by decide
  have h31 : (3 : ZMod 6) ≠ 1 := by decide
  have h41 : (4 : ZMod 6) ≠ 1 := by decide
  have h30 : (3 : ZMod 6) ≠ 0 := by decide
  have h40 : (4 : ZMod 6) ≠ 0 := by decide
  rcases hcentralizer hcomm with hsame | hcomplement
  · subst β
    rcases hactionAlpha with ha | ha <;>
      rcases hactionBeta with hb | hb
    · exact h03 (ha.symm.trans hb)
    · exact h04 (ha.symm.trans hb)
    · exact h13 (ha.symm.trans hb)
    · exact h14 (ha.symm.trans hb)
  · have hact : action β = 1 - action α := by
      rw [hcomplement, map_sub, map_one]
    rcases hactionAlpha with ha | ha <;>
      rcases hactionBeta with hb | hb
    · exact h31 (hb.symm.trans (hact.trans (by rw [ha]; norm_num)))
    · exact h41 (hb.symm.trans (hact.trans (by rw [ha]; norm_num)))
    · exact h30 (hb.symm.trans (hact.trans (by rw [ha]; norm_num)))
    · exact h40 (hb.symm.trans (hact.trans (by rw [ha]; norm_num)))

/-- Source-faithful version of the orientation argument: the scalar action is
defined on the level-preserving subring, not on the ambient quaternion
division ring. -/
theorem orientation_actions_noncommute_of_preserving_subring
    {R : Type*} [Ring R] (O : Subring R) (α β : R)
    (hα : α ∈ O) (hβ : β ∈ O) (action : O →+* ZMod 6)
    (hactionAlpha : action ⟨α, hα⟩ = 0 ∨ action ⟨α, hα⟩ = 1)
    (hactionBeta : action ⟨β, hβ⟩ = 3 ∨ action ⟨β, hβ⟩ = 4)
    (hcentralizer : Commute α β → β = α ∨ β = 1 - α) :
    ¬ Commute α β := by
  intro hcomm
  have h03 : (0 : ZMod 6) ≠ 3 := by decide
  have h04 : (0 : ZMod 6) ≠ 4 := by decide
  have h13 : (1 : ZMod 6) ≠ 3 := by decide
  have h14 : (1 : ZMod 6) ≠ 4 := by decide
  rcases hcentralizer hcomm with hsame | hcomplement
  · have hsub : (⟨β, hβ⟩ : O) = ⟨α, hα⟩ := Subtype.ext hsame
    rw [hsub] at hactionBeta
    rcases hactionAlpha with ha | ha <;>
      rcases hactionBeta with hb | hb
    · exact h03 (ha.symm.trans hb)
    · exact h04 (ha.symm.trans hb)
    · exact h13 (ha.symm.trans hb)
    · exact h14 (ha.symm.trans hb)
  · have hsub : (⟨β, hβ⟩ : O) = 1 - ⟨α, hα⟩ := Subtype.ext hcomplement
    rw [hsub, map_sub, map_one] at hactionBeta
    rcases hactionAlpha with ha | ha <;>
      rcases hactionBeta with hb | hb
    · exact h13 (by simpa [ha] using hb)
    · exact h14 (by simpa [ha] using hb)
    · exact h03 (by simpa [ha] using hb)
    · exact h04 (by simpa [ha] using hb)

/-- Coprimality over a field is exactly absence of common roots in domain
extensions.  This is the algebraic integral-coordinate/root-collision bridge,
independent of CM geometry. -/
theorem isCoprime_of_no_common_root
    {K : Type u} [Field K] (A B : Polynomial K)
    (hnoCollision : ∀ {L : Type u} [CommRing L] [IsDomain L] [Algebra K L]
      (x : L), ¬(aeval x A = 0 ∧ aeval x B = 0)) :
    IsCoprime A B := by
  rw [Polynomial.isCoprime_iff_aeval_ne_zero]
  intro L _ _ _ x
  exact not_and_or.mp (hnoCollision x)

/-- Arithmetic contradiction at the end of the separation proof.  The norm
identity and volume estimate cannot coexist with the strict collision bound. -/
theorem collision_impossible_of_volume
    {ℓ n m : ℕ} (hnorm : n + 1 = 4 * m)
    (hvolume : 6 * ℓ ≤ 4 * m ^ 2)
    (hcollision : (n + 1) ^ 2 < 24 * ℓ) : False := by
  exact not_collision_bound_of_volume_bound hnorm hvolume hcollision

/-- Class-polynomial separation from precise specialization data.  The
hypothesis `hspecialize` is the CM input: a failure of coprimality supplies the
common specialized pair and hence its common norm and the volume inequality.
The remaining contradiction is internal arithmetic. -/
theorem classPolynomial_separation
    {ℓ n : ℕ} (A B : Polynomial (ZMod ℓ))
    (hspecialize : ¬ IsCoprime A B → ∃ m : ℕ,
      n + 1 = 4 * m ∧ 6 * ℓ ≤ 4 * m ^ 2)
    (hcollision : (n + 1) ^ 2 < 24 * ℓ) :
    IsCoprime A B := by
  by_contra hcop
  rcases hspecialize hcop with ⟨m, hnorm, hvolume⟩
  exact collision_impossible_of_volume hnorm hvolume hcollision

/-- The precise data supplied by the cited CM specialization, Arpin local
order description, and Goren--Lauter/Hadamard estimate at one common root.
None of its fields asserts separation or Wronskian nonvanishing. -/
structure CollisionSpecializationData (ℓ n : ℕ) where
  m : ℕ
  norm_identity : n + 1 = 4 * m
  R : Type
  [ringR : Ring R]
  alpha : R
  beta : R
  action : R →+* ZMod 6
  action_alpha : action alpha = 0 ∨ action alpha = 1
  action_beta : action beta = 3 ∨ action beta = 4
  centralizer : Commute alpha beta → beta = alpha ∨ beta = 1 - alpha
  latticeCovolume : ℕ
  covolume_lower : ¬ Commute alpha beta → 6 * ℓ ≤ latticeCovolume
  hadamard_upper : ¬ Commute alpha beta → latticeCovolume ≤ 4 * m * m

/-- The external geometric data imply the numerical volume bound internally. -/
theorem CollisionSpecializationData.volume_bound
    {ℓ n : ℕ} (d : CollisionSpecializationData ℓ n) :
    6 * ℓ ≤ 4 * d.m ^ 2 := by
  letI : Ring d.R := d.ringR
  let hnoncomm : ¬ Commute d.alpha d.beta :=
    orientation_actions_noncommute_of_centralizer d.alpha d.beta d.action
      d.action_alpha d.action_beta d.centralizer
  have h := levelSix_volume_inequality
    (d.covolume_lower hnoncomm) (d.hadamard_upper hnoncomm)
  simpa [pow_two, mul_assoc] using h

/-- Root-by-root separation using the granular cited-data record. -/
theorem classPolynomial_separation_of_collision_data
    {ℓ n : ℕ} (hprime : ℓ.Prime) (A B : Polynomial (ZMod ℓ))
    (hrootSpecialize : ∀ {L : Type} [CommRing L] [IsDomain L]
      [Algebra (ZMod ℓ) L] (x : L),
      aeval x A = 0 → aeval x B = 0 → CollisionSpecializationData ℓ n)
    (hcollision : (n + 1) ^ 2 < 24 * ℓ) :
    IsCoprime A B := by
  letI : Fact ℓ.Prime := ⟨hprime⟩
  apply isCoprime_of_no_common_root (K := ZMod ℓ) A B
  intro L _ _ _ x hroot
  let d := hrootSpecialize x hroot.1 hroot.2
  exact collision_impossible_of_volume d.norm_identity d.volume_bound hcollision

/-- Root-by-root separation.  The remaining external CM-specialization
premise is precise: a common root in any domain extension produces the common
norm `(n+1)/4` and the quaternionic volume inequality. -/
theorem classPolynomial_separation_of_root_specialization
    {ℓ n : ℕ} (hprime : ℓ.Prime) (A B : Polynomial (ZMod ℓ))
    (hrootSpecialize : ∀ {L : Type} [CommRing L] [IsDomain L]
      [Algebra (ZMod ℓ) L] (x : L),
      aeval x A = 0 → aeval x B = 0 → ∃ m : ℕ,
        n + 1 = 4 * m ∧ 6 * ℓ ≤ 4 * m ^ 2)
    (hcollision : (n + 1) ^ 2 < 24 * ℓ) :
    IsCoprime A B := by
  letI : Fact ℓ.Prime := ⟨hprime⟩
  apply isCoprime_of_no_common_root (K := ZMod ℓ) A B
  intro L _ _ _ x hroot
  rcases hrootSpecialize x hroot.1 hroot.2 with ⟨m, hnorm, hvolume⟩
  exact collision_impossible_of_volume hnorm hvolume hcollision

/-- The separated low-degree Wronskian lemma in the notation of the paper. -/
theorem classPolynomial_wronskian_nonzero
    {ℓ : ℕ} (hprime : ℓ.Prime) (A B : Polynomial (ZMod ℓ))
    (hcop : IsCoprime A B) (hmonic : A.Monic)
    (hdegree_pos : 0 < A.natDegree) (hdegree_lt : A.natDegree < ℓ) :
    wronskianObstruction A B ≠ 0 := by
  exact wronskianObstruction_ne_zero_zmod hprime hcop hmonic
    hdegree_pos hdegree_lt

/-- Numerical nonvanishing criterion: specialization plus the collision bound
provides separation, after which the degree interval gives nonvanishing. -/
theorem numerical_wronskian_nonzero
    {ℓ n : ℕ} (hprime : ℓ.Prime) (A B : Polynomial (ZMod ℓ))
    (hspecialize : ¬ IsCoprime A B → ∃ m : ℕ,
      n + 1 = 4 * m ∧ 6 * ℓ ≤ 4 * m ^ 2)
    (hcollision : (n + 1) ^ 2 < 24 * ℓ)
    (hmonic : A.Monic) (hdegree_pos : 0 < A.natDegree)
    (hdegree_lt : A.natDegree < ℓ) :
    wronskianObstruction A B ≠ 0 := by
  apply classPolynomial_wronskian_nonzero hprime A B
  · exact classPolynomial_separation A B hspecialize hcollision
  · exact hmonic
  · exact hdegree_pos
  · exact hdegree_lt


lemma scalar_coefficients_zero_of_not_commute
    {F D : Type*} [Field F] [DivisionRing D] [Algebra F D]
    {x y : D} (hxy : ¬ Commute x y) {a b : F}
    (hab : a • (1 : D) + b • x = 0) : a = 0 ∧ b = 0 := by
  have hb : b = 0 := by
    by_contra hb0
    have hx : x = (-b⁻¹ * a) • (1 : D) := by
      calc
        x = (1 : F) • x := by simp
        _ = (b⁻¹ * b) • x := by rw [inv_mul_cancel₀ hb0]
        _ = b⁻¹ • (b • x) := by rw [smul_smul]
        _ = b⁻¹ • (-(a • (1 : D))) := by
          rw [eq_neg_of_add_eq_zero_right hab]
        _ = (-b⁻¹ * a) • (1 : D) := by
          rw [smul_neg, smul_smul, ← neg_smul]
          congr 1
          ring
    apply hxy
    show x * y = y * x
    rw [hx, Algebra.smul_def, mul_one]
    exact Algebra.commutes _ _
  subst b
  simp only [zero_smul, add_zero] at hab
  have hamap : algebraMap F D a = 0 := by simpa [Algebra.smul_def] using hab
  exact ⟨(FaithfulSMul.algebraMap_injective F D) (hamap.trans (map_zero _).symm), rfl⟩

/-- Noncommuting elements of a division algebra generate four independent
vectors `1, α, β, αβ` over any central coefficient field. -/
theorem noncommuting_lattice_linearIndependent
    {F D : Type*} [Field F] [DivisionRing D] [Algebra F D]
    (α β : D) (hnoncomm : ¬ Commute α β) :
    LinearIndependent F ![(1 : D), α, β, α * β] := by
  rw [Fintype.linearIndependent_iff]
  intro g hg
  have hrelation :
      (g 0 • (1 : D) + g 1 • α) +
        (g 2 • (1 : D) + g 3 • α) * β = 0 := by
    simpa [Fin.sum_univ_succ, add_assoc, add_mul, smul_mul_assoc] using hg
  have hB : g 2 • (1 : D) + g 3 • α = 0 := by
    by_contra hB0
    let A : D := g 0 • (1 : D) + g 1 • α
    let B : D := g 2 • (1 : D) + g 3 • α
    have hAB : A + B * β = 0 := by simpa [A, B] using hrelation
    have hβ : β = -B⁻¹ * A := by
      calc
        β = 1 * β := by rw [one_mul]
        _ = (B⁻¹ * B) * β := by rw [inv_mul_cancel₀ hB0]
        _ = B⁻¹ * (B * β) := by rw [mul_assoc]
        _ = B⁻¹ * (-A) := by rw [eq_neg_of_add_eq_zero_right hAB]
        _ = -B⁻¹ * A := by rw [mul_neg, neg_mul]
    have hscalar (r : F) : Commute α (r • (1 : D)) := by
      rw [Algebra.smul_def, mul_one]
      exact (Algebra.commutes r α).symm
    have hmultiple (r : F) : Commute α (r • α) := by
      rw [Algebra.smul_def]
      show α * (algebraMap F D r * α) =
        (algebraMap F D r * α) * α
      rw [← mul_assoc, (Algebra.commutes r α)]
    have hA : Commute α A := by
      dsimp [A]
      exact (hscalar _).add_right (hmultiple _)
    have hBcomm : Commute α B := by
      dsimp [B]
      exact (hscalar _).add_right (hmultiple _)
    apply hnoncomm
    rw [hβ]
    exact hBcomm.inv_right₀.neg_right.mul_right hA
  have hg23 := scalar_coefficients_zero_of_not_commute hnoncomm hB
  have hA : g 0 • (1 : D) + g 1 • α = 0 := by
    simpa [hB] using hrelation
  have hg01 := scalar_coefficients_zero_of_not_commute hnoncomm hA
  intro i
  fin_cases i <;> simp_all

end SptCM
