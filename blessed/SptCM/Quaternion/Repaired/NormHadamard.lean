module

public import blessed.SptCM.Quaternion.Repaired.CommonRootSeparation
public import Mathlib.Tactic

public section

-- Use the standard additive structure already supplied by the ring instance.
attribute [-instance] instAddCommGroupOfIsSimpleAddGroupOfIsNilpotent


/-!
# The norm table and Hadamard application in I20

This file separates the two algebraic calculations in the quaternionic volume
argument from the still-open local covolume calculation.  The metric
normalization is stated pointwise rather than packaged together with the
conclusion, and the only cited input to the Hadamard step is E9's general
Goren--Lauter inequality.
-/

namespace SptCM.Repair

noncomputable section

open SptCM.RolenLiterature

/-- I20, the paper-specific application of Arpin's theorem.  Supersingularity
and the order-six cyclic level structure are the only application checks; the
level-six Eichler-order conclusion comes from the exact general E9 theorem. -/
theorem preservingOrder_isEichlerOfLevelSix
    {Curve Subgroup Order Lattice D : Type*}
    (EC : EichlerCovolumeModel Curve Subgroup Order Lattice D)
    (hArpin : ArpinLevelSix EC) (E : Curve) (C : Subgroup)
    (hSupersingular : EC.supersingular E)
    (hCyclic : EC.cyclicOfOrderSix C) :
    EC.isEichlerOfLevelSix (EC.preservingOrder E C) :=
  hArpin E C hSupersingular hCyclic

/-- Primitive local-index data for the paper's rank-four lattice.  The record
stores the discriminant covolume, the separate indices at `2` and `3`, and
the exact finite-index scaling to the lattice generated by
`1, α, β, αβ`.  It deliberately has no field asserting either the desired
`6ℓ` lower bound or the final volume inequality. -/
structure LevelSixLocalIndexData
    (ℓ : ℕ)
    {Curve Subgroup Order Lattice D : Type*}
    [One D] [Mul D]
    (EC : EichlerCovolumeModel Curve Subgroup Order Lattice D)
    (E : Curve) (C : Subgroup)
    (_hEichler : EC.isEichlerOfLevelSix (EC.preservingOrder E C))
    (α β : D) where
  maximalOrderCovolume : ℝ
  indexAtTwo : ℕ
  indexAtThree : ℕ
  spanIndex : ℕ
  maximalOrderCovolume_eq : maximalOrderCovolume = ℓ
  indexAtTwo_eq : indexAtTwo = 2
  indexAtThree_eq : indexAtThree = 3
  spanIndex_pos : 0 < spanIndex
  maximalOrderCovolume_nonnegative : 0 ≤ maximalOrderCovolume
  spanCovolume_eq :
    EC.covolume (EC.span (1 : D) α β (α * β)) =
      (spanIndex : ℝ) *
        ((indexAtTwo : ℝ) * indexAtThree * maximalOrderCovolume)

/-- The covolume of the level-six preserving order computed from its three
local factors. -/
@[expose]
noncomputable def LevelSixLocalIndexData.orderCovolume
    {ℓ : ℕ}
    {Curve Subgroup Order Lattice D : Type*}
    [One D] [Mul D]
    {EC : EichlerCovolumeModel Curve Subgroup Order Lattice D}
    {E : Curve} {C : Subgroup}
    {_hEichler : EC.isEichlerOfLevelSix (EC.preservingOrder E C)}
    {α β : D}
    (L : LevelSixLocalIndexData ℓ EC E C _hEichler α β) : ℝ :=
  (L.indexAtTwo : ℝ) * L.indexAtThree * L.maximalOrderCovolume

/-- I20, local covolume computation.  Multiplying the internally verified
indices `2` and `3` by the discriminant-`ℓ` maximal-order covolume gives
exactly `6ℓ`. -/
theorem levelSix_orderCovolume_eq
    {ℓ : ℕ}
    {Curve Subgroup Order Lattice D : Type*}
    [One D] [Mul D]
    {EC : EichlerCovolumeModel Curve Subgroup Order Lattice D}
    {E : Curve} {C : Subgroup}
    {_hEichler : EC.isEichlerOfLevelSix (EC.preservingOrder E C)}
    {α β : D}
    (L : LevelSixLocalIndexData ℓ EC E C _hEichler α β) :
    L.orderCovolume = (6 * ℓ : ℕ) := by
  rw [LevelSixLocalIndexData.orderCovolume, L.indexAtTwo_eq,
    L.indexAtThree_eq, L.maximalOrderCovolume_eq]
  norm_num

/-- I20, local lower covolume.  The lattice generated by the four displayed
elements has positive integral index in the level-six order, so its
covolume is at least `6ℓ`. -/
theorem levelSix_local_covolume_lower
    {ℓ : ℕ}
    {Curve Subgroup Order Lattice D : Type*}
    [One D] [Mul D]
    {EC : EichlerCovolumeModel Curve Subgroup Order Lattice D}
    {E : Curve} {C : Subgroup}
    {_hEichler : EC.isEichlerOfLevelSix (EC.preservingOrder E C)}
    {α β : D}
    (L : LevelSixLocalIndexData ℓ EC E C _hEichler α β) :
    (6 * ℓ : ℝ) ≤ EC.covolume (EC.span (1 : D) α β (α * β)) := by
  rw [L.spanCovolume_eq]
  change (6 * ℓ : ℝ) ≤ (L.spanIndex : ℝ) * L.orderCovolume
  have hindex : (1 : ℝ) ≤ L.spanIndex := by
    exact_mod_cast L.spanIndex_pos
  have horder : 0 ≤ L.orderCovolume := by
    unfold LevelSixLocalIndexData.orderCovolume
    exact mul_nonneg (mul_nonneg (by positivity) (by positivity))
      L.maximalOrderCovolume_nonnegative
  have heq : L.orderCovolume = (6 * ℓ : ℝ) := by
    exact_mod_cast levelSix_orderCovolume_eq L
  rw [← heq]
  nlinarith

/-- The same local data prove nonnegativity of the four-vector covolume. -/
theorem LevelSixLocalIndexData.spanCovolume_nonnegative
    {ℓ : ℕ}
    {Curve Subgroup Order Lattice D : Type*}
    [One D] [Mul D]
    {EC : EichlerCovolumeModel Curve Subgroup Order Lattice D}
    {E : Curve} {C : Subgroup}
    {_hEichler : EC.isEichlerOfLevelSix (EC.preservingOrder E C)}
    {α β : D}
    (L : LevelSixLocalIndexData ℓ EC E C _hEichler α β) :
    0 ≤ EC.covolume (EC.span (1 : D) α β (α * β)) := by
  rw [L.spanCovolume_eq]
  exact mul_nonneg (by positivity)
    (mul_nonneg (mul_nonneg (by positivity) (by positivity))
      L.maximalOrderCovolume_nonnegative)

/-- I20, norm table.  If the squared length used in the Goren--Lauter
inequality is twice a multiplicative reduced norm, and `α` and `β` have common
reduced norm `m`, then the four squared lengths are exactly
`2, 2m, 2m, 2m²`.  In particular, the last equality is proved here from
multiplicativity; it is not an additional normalization hypothesis. -/
theorem reducedNorm_squaredNorm_table
    {Curve Subgroup Order Lattice D : Type*} [Monoid D]
    (EC : EichlerCovolumeModel Curve Subgroup Order Lattice D)
    (N : D →* ℝ) (α β : D) (m : ℕ)
    (hsquaredNorm : ∀ x : D, EC.squaredNorm x = 2 * N x)
    (hnormAlpha : N α = m) (hnormBeta : N β = m) :
    EC.squaredNorm (1 : D) = 2 ∧
      EC.squaredNorm α = 2 * m ∧
      EC.squaredNorm β = 2 * m ∧
      EC.squaredNorm (α * β) = 2 * m ^ 2 := by
  constructor
  · rw [hsquaredNorm, map_one]
    norm_num
  constructor
  · rw [hsquaredNorm, hnormAlpha]
  constructor
  · rw [hsquaredNorm, hnormBeta]
  · rw [hsquaredNorm, map_mul, hnormAlpha, hnormBeta]
    ring

/-- I20, application of Goren--Lauter.  Noncommutation proves linear
independence of `1, α, β, αβ`; compatibility of the concrete E9 model turns
that ordinary linear independence into its `independent` predicate.  The
published general four-vector inequality then gives the numerical square
bound after substituting the norm table. -/
theorem gorenLauter_hadamard_of_noncommuting
    {Curve Subgroup Order Lattice D : Type*}
    [DivisionRing D] [Algebra ℚ D]
    (EC : EichlerCovolumeModel Curve Subgroup Order Lattice D)
    (hGL : GorenLauterHadamard EC) (N : D →* ℝ)
    (α β : D) (m : ℕ)
    (hnoncomm : ¬ Commute α β)
    (hindependent :
      LinearIndependent ℚ ![(1 : D), α, β, α * β] →
        EC.independent (1 : D) α β (α * β))
    (hsquaredNorm : ∀ x : D, EC.squaredNorm x = 2 * N x)
    (hnormAlpha : N α = m) (hnormBeta : N β = m) :
    EC.covolume (EC.span (1 : D) α β (α * β)) ^ 2 ≤
      16 * (m : ℝ) ^ 4 := by
  have hLI : LinearIndependent ℚ ![(1 : D), α, β, α * β] :=
    SptCM.noncommuting_lattice_linearIndependent α β hnoncomm
  rcases reducedNorm_squaredNorm_table EC N α β m hsquaredNorm
      hnormAlpha hnormBeta with
    ⟨hnormOne, hnormAlphaSquared, hnormBetaSquared, hnormProduct⟩
  have hHadamard := hGL (1 : D) α β (α * β) (hindependent hLI)
  rw [hnormOne, hnormAlphaSquared, hnormBetaSquared, hnormProduct] at hHadamard
  nlinarith

/-- I20, complete level-six volume inequality.  Arpin identifies the
preserving order, the separate local-index computation supplies its `6ℓ`
lower covolume, and Goren--Lauter plus the internally proved norm table gives
the upper square bound. -/
theorem levelSix_volume_inequality_of_local_indices
    {ℓ m : ℕ}
    {Curve Subgroup Order Lattice D : Type*}
    [DivisionRing D] [Algebra ℚ D]
    (EC : EichlerCovolumeModel Curve Subgroup Order Lattice D)
    (hArpin : ArpinLevelSix EC) (hGL : GorenLauterHadamard EC)
    (E : Curve) (C : Subgroup) (N : D →* ℝ) (α β : D)
    (hSupersingular : EC.supersingular E)
    (hCyclic : EC.cyclicOfOrderSix C)
    (hnoncomm : ¬ Commute α β)
    (hindependent :
      LinearIndependent ℚ ![(1 : D), α, β, α * β] →
        EC.independent (1 : D) α β (α * β))
    (hsquaredNorm : ∀ x : D, EC.squaredNorm x = 2 * N x)
    (hnormAlpha : N α = m) (hnormBeta : N β = m)
    (localIndexData : ∀ hEichler :
      EC.isEichlerOfLevelSix (EC.preservingOrder E C),
      LevelSixLocalIndexData ℓ EC E C hEichler α β) :
    6 * ℓ ≤ 4 * m ^ 2 := by
  have hEichler :
      EC.isEichlerOfLevelSix (EC.preservingOrder E C) :=
    preservingOrder_isEichlerOfLevelSix EC hArpin E C
      hSupersingular hCyclic
  let L := localIndexData hEichler
  have hlower :
      (6 * ℓ : ℝ) ≤ EC.covolume (EC.span (1 : D) α β (α * β)) :=
    levelSix_local_covolume_lower L
  have hupper :
      EC.covolume (EC.span (1 : D) α β (α * β)) ^ 2 ≤
        16 * (m : ℝ) ^ 4 :=
    gorenLauter_hadamard_of_noncommuting EC hGL N α β m hnoncomm
      hindependent hsquaredNorm hnormAlpha hnormBeta
  have hcovnonneg :
      0 ≤ EC.covolume (EC.span (1 : D) α β (α * β)) :=
    L.spanCovolume_nonnegative
  have hreal : (6 * ℓ : ℝ) ≤ 4 * (m : ℝ) ^ 2 := by
    have hm : (0 : ℝ) ≤ m := by positivity
    nlinarith [sq_nonneg
      (EC.covolume (EC.span (1 : D) α β (α * β)) -
        4 * (m : ℝ) ^ 2)]
  exact_mod_cast hreal

end

end SptCM.Repair
